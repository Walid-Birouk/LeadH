# The Signal reader's provider is set in config/leadh.yaml (DeepSeek Flash by default).
# LLM_BASE_URL and LLM_MODEL override it; LLM_BASE_URL=mock runs a keyword-based reader offline.
DEEPSEEK_API_KEY=

# Web search used by the Site matcher when search.provider is brave. Check its terms allow this use first.
BRAVE_API_KEY=
