# The Signal reader's provider is set in config/leadh.yaml (DeepSeek Flash by default).
# LLM_BASE_URL and LLM_MODEL override it; LLM_BASE_URL=mock runs a keyword-based reader offline.
DEEPSEEK_API_KEY=

# Brave Search API, used by the Site matcher (search.provider in config/leadh.yaml).
BRAVE_SEARCH_API_KEY=

# Mailbox for `leadh to-mailbox`, which saves drafts into your Drafts folder and never sends.
# Outlook.com / Microsoft 365: no password works over IMAP any more; set LEADH_MAIL_MS_CLIENT_ID (see README) and
# sign in once with the code it prints. Gmail, OVH, iCloud and others: an app password.
LEADH_MAIL_USER=
LEADH_MAIL_IMAP_HOST=outlook
LEADH_MAIL_MS_CLIENT_ID=
# LEADH_MAIL_APP_PASSWORD=
# LEADH_MAIL_FROM_NAME=
# LEADH_MAIL_DRAFTS_FOLDER=
